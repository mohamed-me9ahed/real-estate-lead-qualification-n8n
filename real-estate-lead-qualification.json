    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "fields = _items[0][\"json\"][\"body\"][\"data\"][\"fields\"]\n\nresult = {}\n\nfor field in fields:\n    value = field.get(\"value\")\n\n    # Convert multiple-choice IDs to their text\n    if field.get(\"options\") and isinstance(value, list):\n        converted_values = []\n\n        for selected_id in value:\n            option = next(\n                (\n                    opt\n                    for opt in field[\"options\"]\n                    if opt[\"id\"] == selected_id\n                ),\n                None\n            )\n\n            if option:\n                converted_values.append(option[\"text\"])\n            else:\n                converted_values.append(selected_id)\n\n        if len(converted_values) == 1:\n            value = converted_values[0]\n        else:\n            value = converted_values\n\n    result[field[\"label\"]] = value\n\n\n# ==========================================\n# LEAD SCORING\n# ==========================================\n\nscore = 0\n\n\n# Property Type\nproperty_type = result.get(\"Property Type\")\n\nproperty_scores = {\n    \"Apartment\": 10,\n    \"Villa\": 15,\n    \"Commercial\": 10\n}\n\nscore += property_scores.get(property_type, 0)\n\n\n# Buy or Rent\nbuy_rent = result.get(\"Buy or Rent\")\n\nbuy_rent_scores = {\n    \"Buy\": 15,\n    \"Rent\": 5\n}\n\nscore += buy_rent_scores.get(buy_rent, 0)\n\n\n# New or Resale\nnew_resale = result.get(\"New or Resale \")\n\nnew_resale_scores = {\n    \"New\": 10,\n    \"Resale\": 10\n}\n\nscore += new_resale_scores.get(new_resale, 0)\n\n\n# First Property Purchase\nfirst_purchase = result.get(\"Frist Property Purchase \")\n\nfirst_purchase_scores = {\n    \"Yes\": 5,\n    \"No\": 10\n}\n\nscore += first_purchase_scores.get(first_purchase, 0)\n\n\n# Timeline\ntimeline = result.get(\"Timeline\")\n\ntimeline_scores = {\n    \"Immediately\": 20,\n    \"Within 1 month\": 15,\n    \"1-3 months\": 10,\n    \"3-6 months\": 5,\n    \"+6 months\": 0\n}\n\nscore += timeline_scores.get(timeline, 0)\n\n\n# Budget Range\nbudget = result.get(\"Budget Range\")\n\nbudget_scores = {\n    \"Above 1.000.000\": 20,\n    \"700.000$ - 1.000.000$\": 15,\n    \"400.000 - 700.000\": 10,\n    \"400.000 - 200.000\": 5,\n    \"Below 200.000\": 0\n}\n\nscore += budget_scores.get(budget, 0)\n\n\n# Add final score to output\nresult[\"Lead Score\"] = score\n\n\nreturn [{\"json\": result}]"
      },
